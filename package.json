{
  "name": "suber-agent-team",
  "version": "0.5.0",
  "description": "Hardened fork of Suber Agent Team: a stdio MCP server that offloads read-only research from Claude Code to helper models on an Anthropic Console API key.",
  "type": "module",
  "bin": {
    "suber-agent-team": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "suber.config.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "inspector": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "check": "tsc --noEmit -p . && bun run scripts/hardening-check.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "subagent",
    "suber",
    "agent-team",
    "fan-out",
    "token-saving",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
